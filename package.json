{
  "name": "mkw-data-api",
  "version": "1.3.0",
  "private": true,
  "description": "Community-maintained REST API for Mario Kart World character stats, vehicle data, and track information.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "fetch-data": "tsx scripts/fetch-statpedia.ts",
    "generate-data": "tsx scripts/parse-statpedia.ts",
    "smoke": "tsx scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiddenvector/mkw-data-api.git"
  },
  "keywords": [],
  "author": "Hidden Vector Studio",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hiddenvector/mkw-data-api/issues"
  },
  "homepage": "https://github.com/hiddenvector/mkw-data-api#readme",
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.9",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "csv-parse": "^7.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.147.0"
  }
}
